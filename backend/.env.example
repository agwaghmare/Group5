# Copy to .env (git-ignored). Never commit real credentials.
APP_ENV=dev
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
# TIGER_SERVICE_ID=ernvuaxenn   # dev only: resolve the URL through the tiger CLI if DATABASE_URL is unset
JWT_SECRET=change-me-to-a-long-random-value
DEMO_LOGIN_ENABLED=true
REDIS_URL=redis://localhost:6379/0

# Employee API settings are separate from the customer database/login.
# Local-only demo. Never use demo persona login on a public deployment.
STAFF_DEMO_ENABLED=true
STAFF_DATABASE_URL=
STAFF_ADMIN_DATABASE_URL=
# Empty URL uses backend/storage/staff.sqlite3 (API isolation only).
# PostgreSQL URL: postgresql://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require
STAFF_SESSION_HOURS=8
STAFF_GRANT_MINUTES=15
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
AGENT_PROVIDER=mock
BESSIE_API_KEY=YOUR_BESSIE_API_KEY
AMELIA_API_KEY=YOUR_AMELIA_API_KEY
WILBUR_API_KEY=YOUR_WILBUR_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
