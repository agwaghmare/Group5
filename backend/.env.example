# Copy to .env (git-ignored). Never commit real credentials.
APP_ENV=dev                      # dev | test | prod (prod disables demo login and wildcard CORS)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
# TIGER_SERVICE_ID=ernvuaxenn   # dev only: resolve the URL through the tiger CLI if DATABASE_URL is unset
JWT_SECRET=change-me-to-a-long-random-value
DEMO_LOGIN_ENABLED=true          # forced off when APP_ENV=prod
REDIS_URL=redis://localhost:6379/0
