# Copy to .env (git-ignored). Never commit real credentials.
APP_ENV=dev
DATABASE_URL=sqlite:///storage/finpilot_local.sqlite3
DEMO_LOGIN_ENABLED=true

# Same SQLAlchemy database and identity directory for customers and employees.
# Demo persona selection is local-only; never expose it publicly.
STAFF_DEMO_ENABLED=true
STAFF_SESSION_HOURS=8
STAFF_GRANT_MINUTES=15
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
AGENT_PROVIDER=mock
BESSIE_API_KEY=YOUR_BESSIE_API_KEY
AMELIA_API_KEY=YOUR_AMELIA_API_KEY
WILBUR_API_KEY=YOUR_WILBUR_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
