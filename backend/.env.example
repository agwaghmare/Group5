# Copy to .env (git-ignored). Never commit real credentials.
APP_ENV=dev
DATABASE_URL=sqlite:///storage/finpilot_local.sqlite3

# Solana: local test validator by default (free test SOL).
SOLANA_RPC_URL=http://127.0.0.1:8899
SOLANA_NETWORK=localnet
# SOLANA_KEYPAIR_PATH=storage/solana-local-keypair.json
# SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_NETWORK=devnet

# Same SQLAlchemy database and identity directory for customers and employees.
STAFF_SESSION_HOURS=8
STAFF_GRANT_MINUTES=15
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Amelia (customer) and Bessie/Wilbur (staff) use NVIDIA NIM.
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Natural assistant speech; keep the real key in the ignored backend .env only.
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY

# Normal sign-in uses provisioned database accounts.
DEMO_LOGIN_ENABLED=false
STAFF_DEMO_ENABLED=false
SEED_DEMO_DATA=false
